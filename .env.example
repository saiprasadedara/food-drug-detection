# ===================================================
# FOOD x DRUG MOLECULAR INTELLIGENCE - ENVIRONMENT CONFIG
# ===================================================

# Environment Mode
ENVIRONMENT=development
DEBUG=true

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default local development uses SQLite file:
DATABASE_URL=sqlite:///./food_drug_intelligence.db
# For PostgreSQL container / production:
# DATABASE_URL=postgresql://food_drug_user:secure_scientific_password@localhost:5432/food_drug_db

# PostgreSQL Container Setup (docker-compose)
POSTGRES_USER=food_drug_user
POSTGRES_PASSWORD=secure_scientific_password
POSTGRES_DB=food_drug_db
POSTGRES_PORT=5432

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api

# Frontend Configuration
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# Model Pipeline Metadata
MODEL_VERSION=v2.4.1-rc
MODEL_ENVIRONMENT="DEMO MODEL (RDKit + XGBoost Hybrid Pipeline)"
