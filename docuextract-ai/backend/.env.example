# ==============================================================
# DocuExtract AI - Backend Environment Variables
# ==============================================================

# Server Environment & Port
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Maximum File Upload Size (in Megabytes)
MAX_FILE_SIZE_MB=25

# ==============================================================
# Firebase Admin Configuration
# ==============================================================
# Option 1: Path to Firebase Service Account JSON file (Recommended for local dev)
# Place your serviceAccountKey.json in the backend directory or specify absolute path
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Option 2: Individual credential fields (for container / cloud deployments)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC5...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# ==============================================================
# Google Cloud Document AI Configuration
# ==============================================================
# Your GCP Project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Location of your Document AI Processor (e.g. us, eu)
DOCUMENT_AI_LOCATION=us

# The Processor ID created in GCP Console -> Document AI (e.g. "ocr-processor" ID: 7b31276a77884149)
DOCUMENT_AI_PROCESSOR_ID=your-document-ai-processor-id

# Optional: Path to Google Application Credentials if different from Firebase
GOOGLE_APPLICATION_CREDENTIALS=
